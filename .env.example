DB_PASSWORD=changeme
DATABASE_URL=postgresql://dblp:changeme@db/dblp
# CHAT-2 safety: sql_query runs through this read-only role, not the app's
# own connection (see db/init/004_readonly_role.sql).
DATABASE_URL_READONLY=postgresql://dblp_readonly:dblp_readonly_pw@db/dblp
WEB_PORT=8080
OLLAMA_URL=http://ollama:11434
# Default per §8.5. If your GPU has less than ~12GB VRAM (or none), use the
# proposal's own named fallback, qwen3:8b, or a smaller quantisation.
OLLAMA_MODEL=qwen3.5:9b
EMBED_MODEL=nomic-embed-text
# Format: "<start_year>:<comma-separated dblp venue key prefixes>"
# See reports/dblp_profile.md and "2. Initial Slicing Task Table.md" (P1) for
# how the real v1 value was chosen from actual profiled paper counts.
DATA_SCOPE=
DEMO=0
OPENALEX_MAILTO=you@example.com
